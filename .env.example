# Скопируйте в .env (сайт: web/.env.local, Android: android/local.properties) и заполните.
# Публичные значения (можно отдавать в клиент):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
# Флаг демо-входа (анонимная сессия Supabase). Включён по умолчанию для проверки преподавателем.
DEMO_LOGIN_ENABLED=true
# Client ID приложений OAuth (публичные идентификаторы)
YANDEX_CLIENT_ID=
VK_CLIENT_ID=

# Только для Edge Functions (supabase secrets set ...) и CI — НИКОГДА не в клиент:
# SUPABASE_SERVICE_ROLE_KEY задаётся Supabase автоматически внутри функций.
YANDEX_CLIENT_SECRET=
VK_CLIENT_SECRET=
# Адрес сайта для возврата после входа (GitHub Pages)
SITE_URL=https://<user>.github.io/<repo>/
# Доступ CLI к облачному проекту (GitHub Secrets)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Подпись APK (GitHub Secrets)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
