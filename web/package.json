{
  "name": "kgp-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Карта городских проблем — сайт (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "idb": "8.0.4",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
